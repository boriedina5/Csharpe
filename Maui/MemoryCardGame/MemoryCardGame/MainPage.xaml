<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MemoryCardGame.MainPage">
<ContentPage.BlindigContext>
	<vm: GameViewModel/>
</ContentPage.BlindigContext>
	<CollectionView ItemSource="{Blinding cards}" SelectionMode ="None">
		<GridItemLayout Orientation="Vertical" Span="4"/>
	</CollectionView>
	
	<CollectionView.ItemTemplate>
		<DataTemplate>
			<Frame Padding="5" BackgroundColor ="Transparent">
				<Grid>
					<Image Source="{Binding ImageSource}" IsVisible="Blinding isFlipped" HeightRequest="60" WidthRequest="60"/>
					<Button BackgroundColor="Transparent" Command"{Blinding Source={RelativeSource AncestorType={x:Type vm: GameviewModell}}}, Path=FlipCardCommand"
							CommandParameter="{Blinding}"/>
					ding="5" BackgroundColor ="Transparent">
				</Grid>
			</Frame>
		</DataTemplate>
	</CollectionView.ItemTemplate>

</ContentPage>
